{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Хим лаба — дизайн-токены. Источник правды. tokens.css генерируется из этого файла скриптом design/tools/build.mjs. Ссылки вида {color.ink.900} — алиасы.",
  "meta": {
    "name": "him-lab",
    "version": "0.1.0",
    "prefix": "",
    "naming": "CSS-переменная = путь через дефис: color.ink.900 → --color-ink-900"
  },
  "color": {
    "ink": {
      "$type": "color",
      "$description": "Чернила: текст, контуры иллюстраций, тёмные элементы",
      "900": { "$value": "#16213F", "$description": "Основной текст, контуры. 15.9:1 на белом" },
      "700": { "$value": "#33406A", "$description": "Вторичный текст. 10:1 на белом" },
      "500": { "$value": "#56628A", "$description": "Приглушённый текст, подписи. 6:1 на белом, 5.1:1 на tile-100" },
      "300": { "$value": "#A7B0CA", "$description": "Неактивные иконки, разделители. Не для текста" },
      "200": { "$value": "#CDD3E4", "$description": "Границы полей и карточек" },
      "100": { "$value": "#E6E9F2", "$description": "Фон неактивных элементов" }
    },
    "paper": { "$type": "color", "$value": "#FFFFFF", "$description": "Бумага: карточки, панели, журнал" },
    "tile": {
      "$type": "color",
      "$description": "Кафель: стены лаборатории и фон страниц (мятный)",
      "50": { "$value": "#F3F9F7" },
      "100": { "$value": "#E4F1EC", "$description": "Фон страницы" },
      "200": { "$value": "#CFE5DE", "$description": "Швы плитки, разделители на фоне" },
      "300": { "$value": "#B2D5CA" }
    },
    "wood": {
      "$type": "color",
      "$description": "Берёзовая фанера: полки и ящики",
      "100": { "$value": "#F7E9CC" },
      "200": { "$value": "#ECD5A9", "$description": "Доска полки" },
      "400": { "$value": "#CDA266", "$description": "Торец полки" },
      "700": { "$value": "#6F4A18", "$description": "Тёмные детали, текст на дереве (5.5:1 на wood-200)" }
    },
    "bench": {
      "$type": "color",
      "$description": "Столешница рабочего стола",
      "top": { "$value": "#D5E0E7" },
      "edge": { "$value": "#A9BCCA" },
      "shadow": { "$value": "#8BA1B3" },
      "slot": { "$value": "#C3D1DB", "$description": "Пустое место для посуды" }
    },
    "copper": {
      "$type": "color",
      "$description": "Купорос: основной цвет действий и ссылок",
      "50": { "$value": "#EEF4FE" },
      "100": { "$value": "#D9E6FC" },
      "300": { "$value": "#86AEF0" },
      "500": { "$value": "#3B78E3" },
      "600": { "$value": "#1F5FCC", "$description": "Основная кнопка. Белый текст 5.9:1" },
      "700": { "$value": "#1A4FAB", "$description": "Hover" },
      "800": { "$value": "#143F8A", "$description": "Active, нижняя «губа» кнопки" }
    },
    "lamp": {
      "$type": "color",
      "$description": "Лампа: выделение выбранного, звёзды, акценты. Только с тёмным текстом",
      "100": { "$value": "#FFF5D6" },
      "300": { "$value": "#FFE28F" },
      "400": { "$value": "#FFC93C", "$description": "Кольцо выбора, прогресс" },
      "600": { "$value": "#E0A100" },
      "800": { "$value": "#6E4D00", "$description": "Текст на lamp-100 (7.1:1)" }
    },
    "deep": {
      "$type": "color",
      "$description": "Глубина: всё, что относится к «копнуть глубже»",
      "50": { "$value": "#E8F6F4" },
      "100": { "$value": "#CDEDE8" },
      "500": { "$value": "#14918A" },
      "600": { "$value": "#0F766E", "$description": "Белый текст 5.5:1" },
      "800": { "$value": "#0A4F4A" }
    },
    "grape": {
      "$type": "color",
      "$description": "Марганцовка: открытия, новые вещества, награды",
      "50": { "$value": "#F6EEFD" },
      "100": { "$value": "#EBDAFA" },
      "400": { "$value": "#A86AE3" },
      "600": { "$value": "#8B2FC9", "$description": "Белый текст 6.3:1" },
      "800": { "$value": "#5E1F8A" }
    },
    "guide": {
      "$type": "color",
      "$description": "Персонаж-проводник Пипа (колба-учёная). Тело — жидкость внутри колбы",
      "body": { "$value": "#8A6CF0" },
      "shade": { "$value": "#6A4FD6" },
      "light": { "$value": "#BCA9FF" },
      "cheek": { "$value": "#FF9DBB" },
      "goggles": { "$value": "#FFC93C" },
      "lens": { "$value": "#CDEBFF" }
    },
    "feedback": {
      "$type": "color",
      "$description": "Обратная связь. Цвет никогда не единственный сигнал: всегда иконка + текст",
      "success": {
        "100": { "$value": "#DDF3E6" },
        "300": { "$value": "#8FD3AE" },
        "600": { "$value": "#1A7046", "$description": "Текст/иконка, 6.1:1 на белом" }
      },
      "info": {
        "100": { "$value": "{color.copper.50}" },
        "300": { "$value": "{color.copper.300}" },
        "600": { "$value": "{color.copper.600}" }
      },
      "neutral": {
        "$description": "«Ничего не произошло» — спокойный серо-синий",
        "100": { "$value": "#EDF0F6" },
        "300": { "$value": "#B9C1D6" },
        "600": { "$value": "#56628A" }
      },
      "caution": {
        "$description": "Стоп-безопасность: янтарь, не красный",
        "100": { "$value": "#FFF0D9" },
        "300": { "$value": "#F5B860" },
        "500": { "$value": "#C97100", "$description": "Иконка, рамка (3.6:1 к белому — только неречевые элементы и крупный текст)" },
        "700": { "$value": "#A34A05", "$description": "Текст 5.9:1 на белом, 5.3:1 на caution-100" }
      },
      "danger": {
        "$description": "Только для разрушительных действий без отмены (в MVP почти не нужен)",
        "100": { "$value": "#FDE7E4" },
        "600": { "$value": "#C0352B" }
      }
    },
    "lab": {
      "$type": "color",
      "$description": "Цвета иллюстраций лаборатории",
      "outline": { "$value": "{color.ink.900}" },
      "glass": { "$value": "#EAF6FF", "$description": "Заливка стекла, opacity .55" },
      "glass-shine": { "$value": "#FFFFFF" },
      "metal": { "$value": "#C9D3DD" },
      "metal-dark": { "$value": "#8E9DAE" },
      "rubber": { "$value": "#3E4A6B" },
      "flame-outer": { "$value": "#FF8A1F" },
      "flame-inner": { "$value": "#FFD23F" },
      "flame-base": { "$value": "#4FA3FF" },
      "heat-glow": { "$value": "#FF6B3D" },
      "ice": { "$value": "#D4F1FF" },
      "cold": { "$value": "#7CC4FF" },
      "steam": { "$value": "#FFFFFF" },
      "foam": { "$value": "#FFFFFF" },
      "filter-paper": { "$value": "#F8F5EE" },
      "magnet": { "$value": "#E2483D", "$description": "Подкова магнита" },
      "thermo": { "$value": "#E2483D", "$description": "Столбик термометра (подкрашенный спирт)" },
      "ph-paper": { "$value": "#F2C66D", "$description": "Сухая индикаторная бумага" },
      "bulb": { "$value": "#F07A5A", "$description": "Резиновая груша пипетки" }
    },
    "substance": {
      "$type": "color",
      "$description": "Цвета веществ и растворов. Жидкость рисуется с opacity из lab.liquid-opacity",
      "water": { "$value": "#CDE9FB", "$description": "Вода и прозрачные растворы (соль, сахар, сода, уксус)" },
      "water-surface": { "$value": "#8CC8EE" },
      "cloudy-white": { "$value": "#EEF1F0", "$description": "Мутная взвесь: крахмал, мел в воде" },
      "powder-salt": { "$value": "#FFFFFF" },
      "powder-sugar": { "$value": "#FFFDF4" },
      "powder-soda": { "$value": "#FAFBFF" },
      "powder-starch": { "$value": "#FFFFFF" },
      "powder-chalk": { "$value": "#F3F1EA" },
      "iodine": { "$value": "#B5651D", "$description": "Раствор йода" },
      "iodine-starch": { "$value": "#1F2570", "$description": "Йод + крахмал: тёмно-синий" },
      "copper-sulfate": { "$value": "#3A8EDB", "$description": "Медный купорос" },
      "permanganate": { "$value": "#8E1B8E", "$description": "Марганцовка" },
      "peroxide": { "$value": "#E3F3FB" },
      "milk": { "$value": "#FBFAF4" },
      "oil": { "$value": "#F2D166" },
      "caramel": { "$value": "#A0611C", "$description": "Расплавленный сахар при нагреве" },
      "lime-water": { "$value": "#E2F0F5" },
      "lime-water-cloudy": { "$value": "#E9ECEE" },
      "sand": { "$value": "#D9B779" },
      "iron": { "$value": "#5B616B" },
      "ice": { "$value": "#E1F5FF" },
      "cabbage": { "$value": "#7B4FB5", "$description": "Отвар краснокочанной капусты, нейтральный" },
      "litmus": { "$value": "#7C5AA6" },
      "phenolphthalein-base": { "$value": "#E2408B" },
      "bleach": { "$value": "#F1F7D8", "$description": "Хлорное средство (только как пример опасности)" }
    },
    "ph": {
      "$type": "color",
      "$description": "Шкала универсального индикатора (pH-полоска). Промежуточные значения — интерполяция в OKLCH",
      "1": { "$value": "#E3262A" },
      "2": { "$value": "#EC4A2C" },
      "3": { "$value": "#F2752B" },
      "4": { "$value": "#F7A22C" },
      "5": { "$value": "#F6CB2F" },
      "6": { "$value": "#D2D832" },
      "7": { "$value": "#8CC63F" },
      "8": { "$value": "#3DAA5C" },
      "9": { "$value": "#1E9C8C" },
      "10": { "$value": "#2A80C2" },
      "11": { "$value": "#3B57A6" },
      "12": { "$value": "#4A3D93" },
      "13": { "$value": "#5D2B85" },
      "14": { "$value": "#4A1F6B" }
    },
    "ph-cabbage": {
      "$type": "color",
      "$description": "Индикатор из краснокочанной капусты (для урока «попробуй дома»)",
      "2": { "$value": "#D8344F" },
      "4": { "$value": "#C2458A" },
      "6": { "$value": "#8A4FB0" },
      "7": { "$value": "#7B4FB5" },
      "8": { "$value": "#4F63C8" },
      "10": { "$value": "#2C9C8A" },
      "12": { "$value": "#6FB83C" },
      "13": { "$value": "#E3D23A" }
    },
    "semantic": {
      "$type": "color",
      "$description": "Семантические алиасы — в компонентах используйте их",
      "bg": { "$value": "{color.tile.100}" },
      "bg-subtle": { "$value": "{color.tile.50}" },
      "surface": { "$value": "{color.paper}" },
      "surface-sunken": { "$value": "{color.ink.100}" },
      "text": { "$value": "{color.ink.900}" },
      "text-secondary": { "$value": "{color.ink.700}" },
      "text-muted": { "$value": "{color.ink.500}" },
      "text-disabled": { "$value": "{color.ink.300}" },
      "border": { "$value": "{color.ink.200}" },
      "border-strong": { "$value": "{color.ink.900}" },
      "primary": { "$value": "{color.copper.600}" },
      "primary-hover": { "$value": "{color.copper.700}" },
      "primary-active": { "$value": "{color.copper.800}" },
      "primary-soft": { "$value": "{color.copper.50}" },
      "on-primary": { "$value": "{color.paper}" },
      "focus": { "$value": "{color.ink.900}" },
      "focus-halo": { "$value": "{color.lamp.400}" },
      "selected": { "$value": "{color.lamp.400}" },
      "selected-soft": { "$value": "{color.lamp.100}" },
      "deeper": { "$value": "{color.deep.600}" },
      "discovery": { "$value": "{color.grape.600}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": "'Unbounded', 'Golos Text', system-ui, sans-serif", "$description": "Заголовки H1–H3, названия миссий, цифры наград. Google Fonts, OFL, кириллица" },
      "text": { "$value": "'Golos Text', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif", "$description": "Весь интерфейс и текст. Google Fonts, OFL, кириллица" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "black": { "$value": 800 }
    }
  },
  "text": {
    "$description": "Типографическая шкала. size/line в px; в CSS — rem при корне 16px",
    "display": { "size": { "$type": "dimension", "$value": "56px" }, "line": { "$type": "dimension", "$value": "60px" }, "weight": { "$value": 700 }, "family": { "$value": "display" }, "tracking": { "$value": "-0.02em" } },
    "h1": { "size": { "$type": "dimension", "$value": "36px" }, "line": { "$type": "dimension", "$value": "44px" }, "weight": { "$value": 700 }, "family": { "$value": "display" }, "tracking": { "$value": "-0.015em" } },
    "h2": { "size": { "$type": "dimension", "$value": "28px" }, "line": { "$type": "dimension", "$value": "36px" }, "weight": { "$value": 600 }, "family": { "$value": "display" }, "tracking": { "$value": "-0.01em" } },
    "h3": { "size": { "$type": "dimension", "$value": "21px" }, "line": { "$type": "dimension", "$value": "28px" }, "weight": { "$value": 600 }, "family": { "$value": "display" }, "tracking": { "$value": "0" } },
    "title": { "size": { "$type": "dimension", "$value": "20px" }, "line": { "$type": "dimension", "$value": "26px" }, "weight": { "$value": 700 }, "family": { "$value": "text" }, "tracking": { "$value": "0" } },
    "lg": { "size": { "$type": "dimension", "$value": "20px" }, "line": { "$type": "dimension", "$value": "30px" }, "weight": { "$value": 400 }, "family": { "$value": "text" }, "tracking": { "$value": "0" } },
    "md": { "size": { "$type": "dimension", "$value": "18px" }, "line": { "$type": "dimension", "$value": "27px" }, "weight": { "$value": 400 }, "family": { "$value": "text" }, "tracking": { "$value": "0" } },
    "sm": { "size": { "$type": "dimension", "$value": "16px" }, "line": { "$type": "dimension", "$value": "23px" }, "weight": { "$value": 400 }, "family": { "$value": "text" }, "tracking": { "$value": "0" } },
    "xs": { "size": { "$type": "dimension", "$value": "15px" }, "line": { "$type": "dimension", "$value": "20px" }, "weight": { "$value": 500 }, "family": { "$value": "text" }, "tracking": { "$value": "0.005em" } },
    "readout": { "size": { "$type": "dimension", "$value": "28px" }, "line": { "$type": "dimension", "$value": "32px" }, "weight": { "$value": 700 }, "family": { "$value": "text" }, "tracking": { "$value": "0" } }
  },
  "space": {
    "$type": "dimension",
    "$description": "Шаг 4 px",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Радиус растёт с размером и «мягкостью» элемента: метка < кнопка < карточка < панель < диалог",
    "xs": { "$value": "6px", "$description": "Метки, чипы pH" },
    "sm": { "$value": "10px", "$description": "Поля, маленькие кнопки" },
    "md": { "$value": "14px", "$description": "Кнопки, карточки веществ" },
    "lg": { "$value": "20px", "$description": "Панели: журнал, полка, док действий" },
    "xl": { "$value": "28px", "$description": "Диалоги, пузырь персонажа" },
    "pill": { "$value": "999px", "$description": "Переключатели, прогресс" }
  },
  "border": {
    "$type": "dimension",
    "thin": { "$value": "1.5px" },
    "base": { "$value": "2px", "$description": "Контур кнопок и карточек" },
    "thick": { "$value": "3px", "$description": "Выделение, фокус" }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Минимум теней. Плоская «губа» снизу вместо размытых теней",
    "lip": { "$value": "0 3px 0 0 rgba(22, 33, 63, 0.18)", "$description": "Нажимаемые элементы: кнопки, карточки веществ" },
    "lip-primary": { "$value": "0 3px 0 0 #143F8A", "$description": "Основная кнопка" },
    "float": { "$value": "0 12px 32px -8px rgba(22, 33, 63, 0.28)", "$description": "Только то, что парит: диалог, перетаскиваемый предмет, тост" },
    "inset": { "$value": "inset 0 2px 0 0 rgba(22, 33, 63, 0.10)", "$description": "Утопленные поля, пустые места на столе" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "100ms", "$description": "Нажатие, смена цвета кнопки" },
      "fast": { "$value": "160ms", "$description": "Hover, фокус, тумблеры" },
      "base": { "$value": "240ms", "$description": "Появление поповеров, вкладки" },
      "slow": { "$value": "400ms", "$description": "Панели, диалоги, пузырь персонажа" },
      "pour": { "$value": "900ms", "$description": "Наливание / пересыпание" },
      "effect": { "$value": "1600ms", "$description": "Типичный эффект реакции" },
      "effect-long": { "$value": "3200ms", "$description": "Осадок, кристаллы, выпаривание (с ускорением «подождать»)" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "enter": { "$value": "cubic-bezier(0.05, 0.7, 0.1, 1)" },
      "exit": { "$value": "cubic-bezier(0.3, 0, 0.8, 0.15)" },
      "pop": { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$description": "Награды, появление пузырька подсказки" },
      "liquid": { "$value": "cubic-bezier(0.45, 0.05, 0.25, 1)", "$description": "Уровень жидкости, смена цвета" },
      "settle": { "$value": "cubic-bezier(0.55, 0, 0.9, 0.5)", "$description": "Падение частиц, оседание" },
      "linear": { "$value": "linear" }
    }
  },
  "z": {
    "$type": "number",
    "base": { "$value": 0 },
    "bench": { "$value": 1 },
    "vessel": { "$value": 2 },
    "effects": { "$value": 3 },
    "sticky": { "$value": 10 },
    "drawer": { "$value": 20 },
    "character": { "$value": 25 },
    "drag": { "$value": 30 },
    "popover": { "$value": 40 },
    "toast": { "$value": 50 },
    "dialog": { "$value": 60 }
  },
  "size": {
    "$type": "dimension",
    "touch-min": { "$value": "44px", "$description": "Минимальная цель касания" },
    "touch": { "$value": "48px", "$description": "Обычная кнопка" },
    "touch-lg": { "$value": "56px", "$description": "Главные кнопки уроков" },
    "action": { "$value": "80px", "$description": "Кнопка действия в доке" },
    "icon-sm": { "$value": "20px" },
    "icon": { "$value": "24px" },
    "icon-lg": { "$value": "32px", "$description": "Иконки действий" },
    "topbar": { "$value": "64px" },
    "shelf": { "$value": "248px" },
    "shelf-compact": { "$value": "200px" },
    "journal": { "$value": "328px" },
    "content-max": { "$value": "1280px" },
    "measure": { "$value": "38em", "$description": "Максимальная длина строки текста" }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Использовать в @media литералами (CSS-переменные в media queries не работают)",
    "tablet-portrait": { "$value": "768px" },
    "tablet-landscape": { "$value": "1024px" },
    "desktop": { "$value": "1280px" },
    "wide": { "$value": "1440px" }
  },
  "lab": {
    "liquid-opacity": { "$type": "number", "$value": 0.85 },
    "glass-opacity": { "$type": "number", "$value": 0.55 },
    "stroke": { "$type": "dimension", "$value": "4", "$description": "Толщина контура иллюстраций в единицах viewBox (сетка оборудования)" },
    "icon-stroke": { "$type": "dimension", "$value": "2.5", "$description": "Толщина контура иконок 32×32" }
  }
}
